<Project Sdk="Microsoft.NET.Sdk">

  <!-- Settings live in Directory.Build.props. Do not repeat them here. -->

  <ItemGroup>
    <ProjectReference Include="../Archive.Core/Archive.Core.csproj" />
    <ProjectReference Include="../Archive.Data/Archive.Data.csproj" />
    <!-- Reading a photo or a voice message means opening the file; the direction is AI → storage, never back. -->
    <ProjectReference Include="../Archive.Media/Archive.Media.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Prompts ship inside the assembly, like migrations, so a published single-file build cannot
      be separated from the text that produced its facts.
    -->
    <EmbeddedResource Include="Extraction/Prompts/*.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests pin the prompt inventory, which is not part of the public surface. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Archive.Ai.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    No model-runtime package, even with search by meaning and transcription built. Every provider
    here is an OpenAI-shaped HTTP endpoint spoken to with HttpClient and System.Text.Json; vectors
    are searched by brute force rather than through sqlite-vec, and speech goes to the endpoint's
    /audio/transcriptions rather than to a bundled Whisper. So the AI half of this app adds nothing
    native to the download, and nothing at all to a build that never enables it (decisions.md D32).
  -->

</Project>
