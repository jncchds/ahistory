<Project Sdk="Microsoft.NET.Sdk">

  <!-- Settings live in Directory.Build.props. Do not repeat them here. -->

  <ItemGroup>
    <ProjectReference Include="../Archive.Core/Archive.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Migrations ship inside the assembly so a published single-file build cannot be separated
      from its schema, and so the migration runner has no filesystem layout to get wrong.
    -->
    <EmbeddedResource Include="Migrations/*.sql" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests assert on the migration inventory, which is not part of the public surface. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Archive.Data.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
