<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Archive.Ui.ViewModels"
             xmlns:controls="clr-namespace:Archive.Ui.Controls"
             xmlns:data="clr-namespace:Archive.Data;assembly=Archive.Data"
             x:Class="Archive.Ui.Views.DiaryView"
             x:DataType="vm:DiaryViewModel">

  <UserControl.DataTemplates>

    <!-- A sentence, and the way to its source: reading the message is how a diary gets checked. -->
    <DataTemplate DataType="vm:DiarySentenceItem">
      <Grid ColumnDefinitions="*,Auto" Margin="0,2">
        <TextBlock Grid.Column="0" TextWrapping="Wrap" Text="{Binding Text}" />
        <Button Grid.Column="1" Content="source" FontSize="10" Padding="6,0" Margin="8,0,0,0"
                VerticalAlignment="Top" Background="Transparent"
                IsEnabled="{Binding CanOpen}" Command="{Binding OpenCommand}" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="vm:DiaryProfileBlock">
      <Border Margin="0,0,0,18" Padding="14,12" CornerRadius="8" Background="{DynamicResource ElevatedBrush}">
        <StackPanel Spacing="4">
          <TextBlock Text="Portrait" FontWeight="SemiBold" />
          <TextBlock Classes="faint" Text="{Binding Note}"
                     IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <ItemsControl ItemsSource="{Binding Sentences}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="vm:DiaryYearBlock">
      <StackPanel Margin="0,14,0,6" Spacing="4">
        <TextBlock Classes="heading" Margin="0" Text="{Binding Title}" />
        <ItemsControl ItemsSource="{Binding Summary}" IsVisible="{Binding HasSummary}" Opacity="0.85" />
      </StackPanel>
    </DataTemplate>

    <!-- §8: silence is content. A diary that only draws entries papers straight over it. -->
    <DataTemplate DataType="vm:DiaryQuietBlock">
      <Grid ColumnDefinitions="*,Auto,*" Margin="0,10">
        <Border Grid.Column="0" Height="1" Background="{DynamicResource DividerBrush}" VerticalAlignment="Center" />
        <Border Grid.Column="1" Margin="12,0" Padding="10,3" CornerRadius="10"
                Background="{DynamicResource ElevatedBrush}">
          <TextBlock Classes="faint" Text="{Binding Text}" />
        </Border>
        <Border Grid.Column="2" Height="1" Background="{DynamicResource DividerBrush}" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="vm:DiaryMonthBlock">
      <StackPanel Margin="0,6" Spacing="3">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock FontWeight="SemiBold" Text="{Binding Title}" IsVisible="{Binding HasEntry}" />
          <TextBlock Classes="faint" Text="{Binding Title}" IsVisible="{Binding !HasEntry}" />
          <TextBlock Classes="faint" VerticalAlignment="Center" Text="{Binding Activity}" />
          <Button Content="{Binding RevisedLabel}" FontSize="10" Padding="6,0" Background="Transparent"
                  IsVisible="{Binding IsRevised}" Command="{Binding TogglePreviousCommand}" />
          <TextBlock Classes="faint" VerticalAlignment="Center" Text="{Binding Note}"
                     IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Sentences}" IsVisible="{Binding HasEntry}" />

        <!-- What the entry said before it was rewritten, quieter: kept, and one click away. -->
        <Border IsVisible="{Binding ShowsPrevious}" Margin="0,4,0,0" Padding="10,6" CornerRadius="6"
                BorderBrush="{DynamicResource AccentMutedBrush}" BorderThickness="2,0,0,0">
          <StackPanel Spacing="2" Opacity="0.7">
            <TextBlock Classes="faint" Text="earlier version" />
            <ItemsControl ItemsSource="{Binding Previous}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </DataTemplate>

  </UserControl.DataTemplates>

  <Grid ColumnDefinitions="300,*">

    <Border Grid.Column="0" Background="{DynamicResource ListBrush}">
      <DockPanel>
        <TextBox DockPanel.Dock="Top" Margin="10" PlaceholderText="Filter people"
                 Text="{Binding PersonFilter}" />

        <ListBox Classes="rows" ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPerson}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="data:PersonRow">
              <Grid ColumnDefinitions="Auto,10,*">
                <controls:Avatar Grid.Column="0" DisplayName="{Binding DisplayName}" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding DisplayName}"
                           TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="13" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <DockPanel Grid.Column="1" Background="{DynamicResource ConversationBrush}">

      <StackPanel DockPanel.Dock="Top" Margin="24,20,24,0" Spacing="4">
        <TextBlock Classes="heading" Margin="0" Text="{Binding SelectedPerson.DisplayName}" />
        <TextBlock Classes="faint" TextWrapping="Wrap"
                   Text="Written by a language model from the facts read out of these conversations. Every sentence opens the message it rests on — check the ones that matter." />
      </StackPanel>

      <TextBlock DockPanel.Dock="Top" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                 Margin="24,10,24,0"
                 IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                 Text="{Binding Error}" />

      <TextBlock DockPanel.Dock="Top" Classes="subtle" TextWrapping="Wrap" Margin="24,14,24,0"
                 IsVisible="{Binding IsEmpty}" Text="{Binding EmptyText}" />

      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Blocks}" Margin="24,10,24,24" MaxWidth="760"
                      HorizontalAlignment="Left" />
      </ScrollViewer>

    </DockPanel>

  </Grid>

</UserControl>
