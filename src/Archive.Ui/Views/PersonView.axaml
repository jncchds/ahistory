<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Archive.Ui.ViewModels"
             xmlns:controls="clr-namespace:Archive.Ui.Controls"
             xmlns:data="clr-namespace:Archive.Data;assembly=Archive.Data"
             x:Class="Archive.Ui.Views.PersonView"
             x:DataType="vm:PersonViewModel">

  <UserControl.DataTemplates>

    <!-- §8: silence is content. A view that only draws messages papers over it. -->
    <DataTemplate DataType="vm:SilenceItem">
      <Grid ColumnDefinitions="*,Auto,*" Margin="0,16">
        <Border Grid.Column="0" Height="1" Background="{DynamicResource DividerBrush}" VerticalAlignment="Center" />
        <Border Grid.Column="1" Margin="12,0" Padding="10,3" CornerRadius="10"
                Background="{DynamicResource ElevatedBrush}">
          <TextBlock Classes="faint" Text="{Binding Text}" />
        </Border>
        <Border Grid.Column="2" Height="1" Background="{DynamicResource DividerBrush}" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="vm:MessageItem">
      <!--
        Alignment carries the speaker, as in any messaging app: yours on the right, theirs on the
        left. The bubble's flattened corner points back at whoever said it.
      -->
      <Grid Margin="0,2" HorizontalAlignment="{Binding Alignment}" MaxWidth="620">
        <Border Classes="bubble" Classes.outgoing="{Binding IsOutgoing}"
                Classes.revealed="{Binding IsRevealed}" Padding="12,8">
          <StackPanel Spacing="3">

            <!-- §4: a group line out of context often reads as nonsense, so it carries the room
                 it was said in and can be opened up. Direct messages need no label: in a view of
                 one person, every incoming bubble is from the same person. -->
            <TextBlock FontSize="12" FontWeight="SemiBold" IsVisible="{Binding ShowsThreadLabel}"
                       Foreground="{DynamicResource AccentBrush}"
                       Text="{Binding ThreadLabel}" />

            <TextBlock TextWrapping="Wrap" Text="{Binding Row.Plaintext}"
                       Classes.fromGroup="{Binding Row.IsFromGroup}" />

            <TextBlock Classes="faint" IsVisible="{Binding Row.MediaCount}"
                       Text="{Binding Row.MediaCount, StringFormat='{}{0} attachment(s)'}" />

            <!-- Time sits bottom-right inside the bubble, where a chat app puts it. -->
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Content="context" FontSize="10" Padding="6,0" Background="Transparent"
                      IsVisible="{Binding CanExpand}" Command="{Binding ToggleContextCommand}" />
              <TextBlock Classes="faint" Text="{Binding Timestamp}" />
            </StackPanel>

            <TextBlock Classes="faint" Text="loading context…" IsVisible="{Binding IsLoadingContext}" />

            <!-- The surrounding conversation, quieter: it is here to make one line legible, not
                 to become part of this person's stream. -->
            <Border IsVisible="{Binding IsExpanded}" Margin="0,4,0,0" Padding="10,6"
                    CornerRadius="6"
                    BorderBrush="{DynamicResource AccentMutedBrush}" BorderThickness="2,0,0,0">
              <ItemsControl ItemsSource="{Binding Context}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="data:PersonMessageRow">
                    <StackPanel Margin="0,2" Opacity="0.7">
                      <TextBlock FontSize="11" FontWeight="SemiBold"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Text="{Binding SenderLabel}" />
                      <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding Plaintext}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>

          </StackPanel>
        </Border>
      </Grid>
    </DataTemplate>

  </UserControl.DataTemplates>

  <Grid ColumnDefinitions="300,*">

    <!-- The people list, as Telegram's second column. -->
    <Border Grid.Column="0" Background="{DynamicResource ListBrush}">
      <DockPanel>
        <TextBox DockPanel.Dock="Top" Margin="10" PlaceholderText="Filter people"
                 Text="{Binding PersonFilter}" />

        <ListBox Classes="rows" ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPerson}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="data:PersonRow">
              <Grid ColumnDefinitions="Auto,10,*">
                <controls:Avatar Grid.Column="0" DisplayName="{Binding DisplayName}" />

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                               FontWeight="SemiBold" FontSize="13" />
                    <Border Background="{DynamicResource AccentMutedBrush}" CornerRadius="3"
                            Padding="4,0" IsVisible="{Binding IsOwner}">
                      <TextBlock Text="you" FontSize="9" VerticalAlignment="Center" />
                    </Border>
                  </StackPanel>
                  <TextBlock Classes="faint"
                             Text="{Binding MessageCount, StringFormat='{}{0:N0} messages'}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- The conversation itself. -->
    <DockPanel Grid.Column="1" Background="{DynamicResource ConversationBrush}">

      <!-- A header naming who this is, as a chat app has. -->
      <Border DockPanel.Dock="Top" Background="{DynamicResource ListBrush}" Padding="16,10"
              IsVisible="{Binding SelectedPerson, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <controls:Avatar Width="38" Height="38"
                           DisplayName="{Binding SelectedPerson.DisplayName}" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock FontWeight="SemiBold" Text="{Binding SelectedPerson.DisplayName}" />
            <TextBlock Classes="faint"
                       Text="{Binding SelectedPerson.MessageCount, StringFormat='{}{0:N0} messages'}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock DockPanel.Dock="Top" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                 Margin="16,10,16,0"
                 IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                 Text="{Binding Error}" />

      <TextBlock DockPanel.Dock="Top" Classes="faint" HorizontalAlignment="Center"
                 Margin="0,8,0,2" Text="loading more messages…"
                 IsVisible="{Binding IsBusy}" />

      <!-- Virtualized: a conversation can run to tens of thousands of messages. -->
      <ItemsControl x:Name="Stream" ItemsSource="{Binding Items}" Margin="16,10,16,10">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.Template>
          <ControlTemplate>
            <ScrollViewer>
              <ItemsPresenter />
            </ScrollViewer>
          </ControlTemplate>
        </ItemsControl.Template>
      </ItemsControl>

    </DockPanel>

  </Grid>

</UserControl>
