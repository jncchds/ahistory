<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Archive.Ui.ViewModels"
        x:Class="Archive.Ui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="ahistory"
        Width="1180" Height="780"
        MinWidth="820" MinHeight="520"
        Background="{DynamicResource ConversationBrush}">

  <Grid ColumnDefinitions="78,*">

    <!--
      The icon rail, as Telegram has for folders: narrow, always visible, and the only piece of
      chrome that never changes. Everything else is the page.
    -->
    <Border Grid.Column="0" Background="{DynamicResource RailBrush}">
      <DockPanel LastChildFill="False">

        <ListBox DockPanel.Dock="Top" Classes="rail" Margin="0,10,0,0"
                 ItemsSource="{Binding Pages}" SelectedItem="{Binding CurrentPage}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ViewModelBase">
              <StackPanel HorizontalAlignment="Center" Spacing="3">
                <TextBlock Text="{Binding Glyph}" FontSize="19" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Title}" FontSize="10" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock DockPanel.Dock="Bottom" Classes="faint" Margin="6,0,6,10"
                   TextWrapping="Wrap" TextAlignment="Center"
                   Text="{Binding SaveName}" ToolTip.Tip="{Binding SavePath}" />

      </DockPanel>
    </Border>

    <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />

  </Grid>

</Window>
