<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Archive.Ui.ViewModels"
             xmlns:views="clr-namespace:Archive.Ui.Views"
             xmlns:data="clr-namespace:Archive.Data;assembly=Archive.Data"
             x:Class="Archive.Ui.Views.SearchView"
             x:DataType="vm:SearchViewModel">

  <UserControl.Styles>
    <!-- The line that was actually matched, inside the surrounding few. -->
    <Style Selector="Border.previewRow.hit">
      <Setter Property="Background" Value="{DynamicResource ElevatedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
  </UserControl.Styles>

  <!--
    Margin rather than Padding: a page is laid out inside a ContentControl that fills the window
    edge to edge, and content pressed against that edge reads as a rendering fault.
  -->
  <DockPanel Margin="24,20">

    <TextBlock DockPanel.Dock="Top" Classes="heading" Text="Search" />

    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,8,180,8,Auto" Margin="0,0,0,12">
      <TextBox Grid.Column="0" Text="{Binding Query}" PlaceholderText="Search every message"
               AcceptsReturn="False">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding RunCommand}" />
        </TextBox.KeyBindings>
      </TextBox>

      <ComboBox Grid.Column="2" ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPerson}"
                HorizontalAlignment="Stretch">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:PersonFilterOption">
            <TextBlock Text="{Binding Display}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <Button Grid.Column="4" Content="Search" Command="{Binding RunCommand}" />
    </Grid>

    <TextBlock DockPanel.Dock="Top" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
               Margin="0,0,0,12"
               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
               Text="{Binding Error}" />

    <TextBlock DockPanel.Dock="Top" Classes="subtle" Margin="0,0,0,8"
               IsVisible="{Binding IsTruncated}"
               Text="{Binding ResultSummary}" />

    <!-- D8: prefix expansion matches the start of words, so a stem finds more than a full
         inflected form. Someone who does not know that concludes the archive is empty. -->
    <Border DockPanel.Dock="Top" IsVisible="{Binding FoundNothing}" Margin="0,0,0,12"
            Padding="12" CornerRadius="4"
            Background="{DynamicResource ElevatedBrush}">
      <TextBlock TextWrapping="Wrap" Text="{Binding EmptyHint}" />
    </Border>

    <!--
      §4: a matched line on its own is often nonsense — "yeah exactly" is the standing example —
      so selecting a result shows the few lines around it, and offers to open it where it was
      said. The panel is bounded so the result list stays the larger half of the page.
    -->
    <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="14,12" CornerRadius="8"
            Background="{DynamicResource ListBrush}"
            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
            IsVisible="{Binding SelectedHit, Converter={x:Static ObjectConverters.IsNotNull}}">
      <DockPanel>

        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"
                       Text="{Binding SelectedHit.ThreadTitle}" />
            <TextBlock Classes="faint" Text="the messages either side of this result" />
          </StackPanel>

          <Button Grid.Column="1" Classes="accent" Content="Open in Conversations"
                  VerticalAlignment="Center"
                  Command="{Binding OpenInConversationCommand}" />
        </Grid>

        <ScrollViewer MaxHeight="240">
          <ItemsControl ItemsSource="{Binding Preview}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SearchPreviewRow">
                <Border Classes="previewRow" Classes.hit="{Binding IsHit}"
                        Margin="0,2" Padding="9,6" CornerRadius="6"
                        BorderThickness="2,0,0,0" BorderBrush="Transparent">
                  <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock FontSize="11" FontWeight="SemiBold"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Text="{Binding SenderLabel}" />
                      <TextBlock Classes="faint" Text="{Binding Timestamp}" />
                    </StackPanel>
                    <!-- Capped: one very long message in the surrounding few would push the
                         matched line off the bottom of the panel, which is the one line the
                         reader opened this to see. -->
                    <TextBlock FontSize="12" TextWrapping="Wrap" MaxLines="3"
                               TextTrimming="CharacterEllipsis" Text="{Binding Text}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

      </DockPanel>
    </Border>

    <ListBox Classes="rows" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedHit}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="data:SearchHit">
          <StackPanel Margin="0,4" Spacing="2">

            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding SenderName}" />
              <TextBlock FontSize="11" Opacity="0.55" Text="{Binding SentAtUtc}" />
              <TextBlock FontSize="11" Opacity="0.55" Text="{Binding ThreadTitle}"
                         TextTrimming="CharacterEllipsis" />

              <!-- §3: a message, a confident transcript and OCR are three levels of trust, and a
                   result that hides which it is turns a mishearing into biography. -->
              <Border Background="#33808080" CornerRadius="3" Padding="5,0">
                <TextBlock FontSize="10" VerticalAlignment="Center" Text="{Binding Provenance}" />
              </Border>
            </StackPanel>

            <TextBlock TextWrapping="Wrap" views:SnippetText.Segments="{Binding Snippet}" />

          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

  </DockPanel>

</UserControl>
