<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Archive.Ui.ViewModels"
             xmlns:views="clr-namespace:Archive.Ui.Views"
             xmlns:data="clr-namespace:Archive.Data;assembly=Archive.Data"
             x:Class="Archive.Ui.Views.SearchView"
             x:DataType="vm:SearchViewModel">

  <DockPanel>

    <TextBlock DockPanel.Dock="Top" Classes="heading" Text="Search" />

    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,8,180,8,Auto" Margin="0,0,0,12">
      <TextBox Grid.Column="0" Text="{Binding Query}" PlaceholderText="Search every message"
               AcceptsReturn="False">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding RunCommand}" />
        </TextBox.KeyBindings>
      </TextBox>

      <ComboBox Grid.Column="2" ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPerson}"
                HorizontalAlignment="Stretch">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:PersonFilterOption">
            <TextBlock Text="{Binding Display}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <Button Grid.Column="4" Content="Search" Command="{Binding RunCommand}" />
    </Grid>

    <TextBlock DockPanel.Dock="Top" Foreground="IndianRed" TextWrapping="Wrap" Margin="0,0,0,12"
               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
               Text="{Binding Error}" />

    <TextBlock DockPanel.Dock="Top" Classes="subtle" Margin="0,0,0,8"
               IsVisible="{Binding IsTruncated}"
               Text="{Binding ResultSummary}" />

    <!-- D8: prefix expansion matches the start of words, so a stem finds more than a full
         inflected form. Someone who does not know that concludes the archive is empty. -->
    <Border DockPanel.Dock="Top" IsVisible="{Binding FoundNothing}" Margin="0,0,0,12"
            Padding="12" CornerRadius="4"
            Background="{DynamicResource SystemControlBackgroundListLowBrush}">
      <TextBlock TextWrapping="Wrap" Text="{Binding EmptyHint}" />
    </Border>

    <ListBox ItemsSource="{Binding Results}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="data:SearchHit">
          <StackPanel Margin="0,6" Spacing="2">

            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding SenderName}" />
              <TextBlock FontSize="11" Opacity="0.55" Text="{Binding SentAtUtc}" />
              <TextBlock FontSize="11" Opacity="0.55" Text="{Binding ThreadTitle}"
                         TextTrimming="CharacterEllipsis" />

              <!-- §3: a message, a confident transcript and OCR are three levels of trust, and a
                   result that hides which it is turns a mishearing into biography. -->
              <Border Background="#33808080" CornerRadius="3" Padding="5,0">
                <TextBlock FontSize="10" VerticalAlignment="Center" Text="{Binding Provenance}" />
              </Border>
            </StackPanel>

            <TextBlock TextWrapping="Wrap" views:SnippetText.Segments="{Binding Snippet}" />

          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

  </DockPanel>

</UserControl>
