<Project Sdk="Microsoft.NET.Sdk">

  <!-- Settings live in Directory.Build.props. Do not repeat them here. -->
  <!--
    Keeping an archive current: folders re-read when a scheduled export lands in them, and accounts
    read from the platform itself (docs/live-sources-plan.md). The storage projects never reference
    this one, so a platform client never becomes a dependency of the storage layer — the same rule
    that keeps a model runtime out of it (SolutionLayoutTests).
  -->

  <ItemGroup>
    <ProjectReference Include="../Archive.Core/Archive.Core.csproj" />
    <ProjectReference Include="../Archive.Data/Archive.Data.csproj" />
    <ProjectReference Include="../Archive.Import/Archive.Import.csproj" />
    <ProjectReference Include="../Archive.Media/Archive.Media.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />

    <!--
      DPAPI, for the session file (SecretFile). Managed code with no native payload — it is a thin
      wrapper over a Windows API that is present on every Windows machine, and on other platforms
      the package is simply unused.
    -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />

    <!--
      Telegram's client protocol, written in C# with no native binaries — so connecting an account
      adds nothing per-platform to a build, which is the property D32 protects for the AI layer.
      MIT. It is what Telegram's own takeout API is reached through.
    -->
    <PackageReference Include="WTelegramClient" Version="4.4.8" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Archive.Sync.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
