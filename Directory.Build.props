<Project>

  <!--
    Shared build settings for every project in the solution.
    Individual csproj files should NOT repeat these — if a setting is here, it is here only.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- A warning we ship is a warning we stop reading. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!--
      The archive is multilingual (Cyrillic in particular). Invariant globalization keeps
      sorting and casing identical on every machine and in every container, so a test that
      passes on Windows cannot fail on Linux for locale reasons. Search casing is handled
      by SQLite's unicode61 tokenizer, not by .NET culture rules.
    -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <!--
      Overridden by the release workflow, which derives the real version from the
      release/x.y.z branch name. A local build says so rather than claiming to be a release.
    -->
    <Version>0.1.0-dev</Version>

    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
